{
  "$schema": "https://dsh.community/schemas/dsh-plugin-0.15.json",
  "id": "caveman-plugin-dsh",
  "name": "caveman-plugin-dsh",
  "version": "0.3.0",
  "manifestVersion": "0.15",
  "facets": {
    "host": {
      "entry": "lib/index.js",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "commands.dsh/v1alpha1",
        "kind": "Command"
      }
    ]
  },
  "permissions": [
    {
      "name": "commands.invoke",
      "scope": "caveman-plugin-dsh.caveman",
      "reason": "Lets the user invoke the /caveman toggle command."
    }
  ],
  "contributes": {
    "commands": [
      {
        "id": "caveman-plugin-dsh.caveman",
        "title": "Caveman",
        "description": "Toggle the caveman voice: /caveman on | off | status | caveman | ultracave | megacave"
      }
    ]
  },
  "subscriptions": [],
  "license": "MIT AND Apache-2.0"
}
